OPENAI_API_KEY="sk-1234"
ANTHROPIC_API_KEY=""
OLLAMA=""
PROMPT_TOOLKIT_NO_CPR=1
CAI_STREAM=false
CAI_MODEL="alias1"
# Model sampling parameters (optional - defaults shown)
# CAI_TEMPERATURE=0.7
# CAI_TOP_P=1.0

# Alias API key (used for alias1, alias2, and alias2-mini)
ALIAS_API_KEY="sk-your-alias-key-here"

# ---------------------------------------------------------------------------
# System One decisions (Jev / Clef) — optional injection guardrails + jev_decide
# ---------------------------------------------------------------------------
# Free path (recommended): Cloudflare Workers AI clef-flash uses the shared
# 10,000 Neurons/day free allocation. Not available for free on GCP Vertex,
# AWS Bedrock, or Azure AI Foundry.
# CAI_JEV_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_API_TOKEN=""          # Workers AI Read permission
# CAI_JEV_MODEL=clef-flash         # or clef / typesafe/jev (paid on CF)
#
# Paid TypeSafe direct:
# CAI_JEV_PROVIDER=typesafe
# TYPESAFE_API_KEY=""              # https://console.typesafe.ai/keys
# TYPESAFE_BASE_URL="https://api.typesafe.ai"
# TYPESAFE_DEFAULT_MODEL="jev-latest"
#
# Paid OpenRouter (no TypeSafe waitlist):
# CAI_JEV_PROVIDER=openrouter
# OPENROUTER_API_KEY=""
#
# When CAI_GUARDRAILS=true and any backend is configured, Jev/Clef screens inputs.
# CAI_JEV_GUARDRAILS=true
# CAI_JEV_JAILBREAK_THRESHOLD=0.75
# CAI_JEV_EXFIL_THRESHOLD=0.8
# CAI_JEV_SEVERITY_BLOCK=2.0

# Open-source mode. Set to 1/true to:
#   - bypass the startup license check (no ALIAS_API_KEY required to start),
#   - route update checks and `cai --update` to public PyPI instead of the
#     private Alias package index.
# CAI_LICENSE_OFF=1

# Set to true ONLY when running an authorised internal pentest. When false (default), fetch_url blocks loopback / RFC1918 / link-local / cloud-metadata hosts and non-http(s) schemes to prevent SSRF via prompt injection.
CAI_FETCH_ALLOW_INTERNAL=false
# Override the User-Agent used by fetch_url (OPSEC).
# CAI_FETCH_USER_AGENT="Mozilla/5.0 ..."
